{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "dev:fresh": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev --hostname localhost --port 3000",
    "dev:restart": "node ./scripts/kill-port.mjs 3000 && npm run dev:fresh",
    "build": "next build",
    "start": "node ./scripts/start.mjs",
    "lint": "echo \"Lint: adicione eslint ao projeto se precisar\" && exit 0",
    "db:seed-master": "node ./scripts/seed-master-user.mjs",
    "db:bootstrap": "node ./scripts/bootstrap-db.mjs",
    "db:check": "node ./scripts/db-check.mjs",
    "supabase:setup": "node ./scripts/supabase-auto-setup.mjs",
    "audit:env": "node ./scripts/audit-env.mjs",
    "render:deploy": "node ./scripts/render-deploy-supabase.mjs",
    "render:openai": "node ./scripts/render-sync-openai.mjs",
    "finalize:openai": "node ./scripts/finalize-openai-production.mjs",
    "validate:prod": "node ./scripts/validate-production.mjs",
    "validate:nutrition": "node ./scripts/validate-nutrition-ai.mjs",
    "validate:nutrition:e2e": "node ./scripts/validate-nutrition-e2e.mjs",
    "validate:scanner:mobile": "node ./scripts/validate-scanner-mobile.mjs",
    "validate:seo": "node ./scripts/validate-seo.mjs",
    "validate:lighthouse": "node ./scripts/lighthouse-seo.mjs",
    "validate:privacy": "node ./scripts/validate-privacy.mjs",
    "db:fix-saas": "node ./scripts/fix-saas.mjs",
    "db:render-setup": "node ./scripts/bootstrap-db.mjs && node ./scripts/seed-master-user.mjs",
    "db:init": "npm run db:bootstrap && npm run db:seed-master",
    "setup": "npm run db:bootstrap && npm run build",
    "go": "npm run db:init && next dev --hostname localhost --port 3000"
  },
