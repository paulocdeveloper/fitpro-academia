# =============================================================================
# FitPro — variáveis de ambiente
# =============================================================================
# Copie para .env e preencha. Valide com:
#   npm run env:check
#   npm run diagnose:env
#
# Setup automático Supabase: npm run supabase:setup
# Login: master@academia.com / Master@123
# =============================================================================

DB_DIALECT=postgres
SUPABASE_PROJECT_REF=seu-project-ref

DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://SEU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

JWT_SECRET=string-longa-minimo-32-caracteres
DB_SSL=true

# Recuperação de senha — e-mail (Resend ou Gmail SMTP)
# Resend (recomendado): https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM=FitPro <noreply@fitproia.com.br>
# Gmail SMTP (alternativa):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@gmail.com
# SMTP_PASS=senha-de-app-google
# EMAIL_FROM=FitPro <seu@gmail.com>

# Recuperação de senha — SMS (opcional, Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+5511999999999

# SEO / Google Search Console (indexação)
NEXT_PUBLIC_SITE_URL=https://fitpro-academia.onrender.com
# Meta tag de verificação (Search Console → Propriedade → Verificação HTML):
# Copie o valor do content="..." e cole abaixo no Render (Environment):
GOOGLE_SITE_VERIFICATION=KCz9wC4niSIgw4eYXIMNHhnkmVgAFUB-5uhMOYA-CvE
# Após verificar, envie o sitemap: https://fitpro-academia.onrender.com/sitemap.xml

# IA Nutricional — GPT-4o Vision (server-side only, nunca no frontend)
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4o

# Premium Nutrição — Mercado Pago assinatura recorrente
# Planos: Mensal R$ 10,90 | Semestral R$ 49,90 | Anual R$ 97,00
# Painel MP → Suas integrações → Webhooks → URL:
#   https://fitpro-academia.onrender.com/api/subscription/webhook
# Tópicos: subscription_preapproval, subscription_authorized_payment
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=...
# IDs dos planos criados no painel Mercado Pago (opcional — sem eles usa auto_recurring):
# MERCADOPAGO_PLAN_ID_MENSAL=
# MERCADOPAGO_PLAN_ID_SEMESTRAL=
# MERCADOPAGO_PLAN_ID_ANUAL=
# Apenas desenvolvimento local (sem token MP):
# MERCADOPAGO_USE_MOCK=true

# DB_HOST=127.0.0.1
# DB_DATABASE=academia
# MYSQL_URL=
