# Copie este ficheiro para .env e preencha com os dados do seu MySQL (HeidiSQL).
# O ficheiro .env não deve ir para o Git (já está no .gitignore).

# MySQL
# WSL: se o MySQL estiver no Windows, troque por o IP do host (no WSL: ip route | grep default | awk '{print $3}')
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=academia

# JWT (mínimo 32 caracteres; em produção use valor forte e único)
JWT_SECRET=gere-uma-string-longa-aleatoria-de-pelo-menos-32-caracteres

# Arranque rápido no Windows: faça duplo clique em rodar.bat (MySQL ligado antes).
# Ubuntu / WSL na pasta do projeto:
#   npm install && npm run db:fix-saas && npm run db:seed-master && npm run dev
#
# Comandos úteis:
#   npm run db:bootstrap   — cria/atualiza base e tabelas
#   npm run db:fix-saas    — só migração SaaS (academia_id + preencher NULL) — use se o login falhar
#   npm run db:seed-master — repõe master@academia.com / Master@123
#   npm run setup          — bootstrap + build (produção)
